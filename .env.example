# Password to access /admin (required).
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (required).
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Optional — Vercel KV / Upstash Redis REST credentials.
# When set, questions + leaderboard persist in KV (required for Vercel deploys,
# since serverless functions don't have a writable persistent filesystem).
# When unset, the app falls back to a local .data/db.json file (dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — Resend API key. When set, each leaderboard join triggers a
# results email (score, tier, full case-by-case recap) to the player.
# When unset, email sending is skipped silently.
RESEND_API_KEY=

# Sender address for results emails (domain must be verified in Resend).
RESEND_FROM_EMAIL=info@delcolaw.com

# Public site URL, used for links/images inside the results email.
NEXT_PUBLIC_SITE_URL=https://legal-challenge-zeta.vercel.app
